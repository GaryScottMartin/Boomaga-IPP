  }
  class JobId {
    +0: Uuid
  }
  enum JobStatus {
    Queued
    Processing
    Completed
    Cancelled
    Failed
    Held
    Aborted
  }
  enum JobPriority {
    Low
    Normal
    High
    Urgent
  }
  enum PageContents {
    Vector
    Raster
    Pdf
  }
  enum FileType {
    Pdf
    PwgRaster
    Jpeg
  }
  enum DuplexMode {
    None
    LongEdge
    ShortEdge
  }
  enum Orientation {
    Portrait
    Landscape
  }
  enum PagesPerSheet {
    One
    Two
    Four
    Six
    Eight
  }
  enum MarginMode
}
