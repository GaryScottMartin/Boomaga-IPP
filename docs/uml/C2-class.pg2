 class JobMetadata {
    +job_id: JobId
    +status: JobStatus
    +priority: JobPriority
    +pages: Vec<PageInfo>
  }
  class JobId {
    +0: Uuid
  }
  enum JobStatus {
    Queued
    Processing
    Completed
    Cancelled
    Failed
    Held
    Aborted
  }
  enum JobPriority {
    Low
    Normal
    High
    Urgent
  }
  enum PageContents {
    Vector
    Raster
    Pdf
  }
  enum FileType {
    Pdf
    PwgRaster
    Jpeg
  }
  enum DuplexMode {
    None
    LongEdge
    ShortEdge
  }
  enum Orientation {
    Portrait
    Landscape
  }
