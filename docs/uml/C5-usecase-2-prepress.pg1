@startuml
title Boomaga-IPP — Use Case Diagram (2)\nPre-press / Pre-printing Document Processing
left to right direction
skinparam packageStyle rectangle

actor "Document producer /\nPre-press operator" as Operator
actor "Source application" as Source
actor "Font and color-profile\nresources" as Resources
actor "DestinationManager" as Destination
actor "DownstreamPrinter\n(printer-specific destination)" as Printer

rectangle "Boomaga-IPP\nPage-oriented Document Processing System" {
  usecase "Create a print-ready\ncompound document" as PREPRESS

  usecase "Import or open\nsource documents" as IMPORT
  usecase "Assemble compound\ndocument" as ASSEMBLE
  usecase "Reorder, insert, delete,\nor rotate pages" as EDIT
  usecase "Apply letterhead, page tags,\nor annotations" as MARKUP
  usecase "Set page geometry,\nscaling, and media" as GEOMETRY
  usecase "Configure imposition\nand finishing intent" as IMPOSE
  usecase "Preflight document" as PREFLIGHT
  usecase "Check fonts, color profiles,\nresolution, and geometry" as CHECK
  usecase "Preview pages and\nimposed sheets" as PREVIEW
  usecase "Resolve preflight\nfindings" as RESOLVE
  usecase "Select output destination\nand inspect capabilities" as SELECT
  usecase "Generate print-ready\nPDF" as PDF
  usecase "Submit print job" as PRINT

  usecase "Plan deterministic\nsubmission batches" as BATCH
  usecase "Set copies, collate, duplex,\nand page selection" as OPTIONS
}
