CUPS --> UC1
UC1 --> UC2
Wayland --> UC4
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC10
UC10 --> UC9 : <<include>>
UC10 --> UC7 : <<include>>
UC10 --> Printer
UC6 ..> UC4 : <<extend>>
UC5 ..> UC4 : <<extend>>

UC1 .[#gray,dashed].> FUT1
User .[#gray,dashed].> FUT2
User .[#gray,dashed].> FUT3
User .[#gray,dashed].> FUT4

legend right
  Normal = realized user/system behavior
  <<planned>> / dashed = decided but not yet wired
endlegend
@enduml
