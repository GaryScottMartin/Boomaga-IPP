package "boomaga-preview (Xilem 0.4)" {
  class AppData {
    +document_path: Option<PathBuf>
    +document: Option<Document>
    +current_page: usize
    +rendered_pages: Vec<Option<CanvasImage>>
    +load_state: LoadState
    +zoom: f64
    +fill_order: FillOrder
    +print_options: PrintOptions
    +page_range_input: String
    +printers: Vec<String>
    +print_state: PrintState
    +job_statuses: HashMap<String, JobStatus>
    +ipc_state: IpcState
    +apply_shortcut(PreviewShortcut)
    +handle_renderer_event(RendererEvent)
    +handle_ipc_event(IpcEvent)
    +handle_print_event(PrintEvent)
  }
  enum PreviewShortcut {
    NextPage
    PreviousPage
    ZoomIn
    ZoomOut
    ResetZoom
  }
  enum LoadState {
    Idle
    Loading
    Ready
    Error
  }
  enum FillOrder {
    Horizontal
    Vertical
  }
  enum IpcState {
    Connecting
    Connected
    Disconnected
  }
