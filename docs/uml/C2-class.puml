@startuml
title Boomaga-IPP — System Class Diagram (conforms to code @ e77d08c)
skinparam classAttributeIconSize 0
hide empty members

package "boomaga-core" {
  class Document {
    +id: String
    +file_path: PathBuf
    +file_type: FileType
    +title: String
    +pages: Vec<Page>
    +page_count(): usize
  }
  class Page {
    +number: usize
    +width: f64
    +height: f64
    +orientation: Orientation
    +contents: PageContents
  }
  class PrintJobRequest {
    +job_id: JobId
    +file_path: PathBuf
    +file_type: FileType
    +printer_name: Option<String>
    +options: PrintOptions
  }
  class PageRange {
    +from_pages(&[usize]): Self
    +pages(page_count): Result<Vec<usize>>
  }
  class PrintOptions {
    +copies: u32
    +collate: bool
    +duplex: DuplexMode
    +orientation: Orientation
    +page_range: Option<PageRange>
    +pages_per_sheet: PagesPerSheet
    +scale: f64
    +margins: MarginMode
    +validate(): Result
  }
  class JobMetadata {
    +job_id: JobId
    +status: JobStatus
    +priority: JobPriority
    +pages: Vec<PageInfo>
  }
  class JobId { +0: Uuid }
  enum JobStatus { Queued; Processing; Completed; Cancelled; Failed; Held; Aborted }
  enum JobPriority { Low; Normal; High; Urgent }
  enum PageContents { Vector; Raster; Pdf }
  enum FileType { Pdf; PwgRaster; Jpeg }
  enum DuplexMode { None; LongEdge; ShortEdge }
  enum Orientation { Portrait; Landscape }
  enum PagesPerSheet { One; Two; Four; Six; Eight }
  enum MarginMode
}

package "boomaga-ipp-backend" {
  class IppServer {
    -port: u16
    -processor: Arc<JobProcessor>
    +run(): Result
  }
  class JobProcessor {
    -queue: Arc<JobQueue>
    -jobs: HashMap<String, JobStatus>
    -notification_sender: NotificationSender
    +add_job(PrintJobRequest): Result
  }
  class JobQueue {
    -queue_size: AtomicUsize
    -max_size: usize
    +push(PrintJobRequest): Result
    +pop(): Result<PrintJobRequest>
  }
  class IppRequest { +operation_id: IppOperation; +data: Vec<u8> }
  class IppResponse { +status_code: IppStatusCode }
  enum IppOperation
  enum IppStatusCode
}

package "boomaga-layout-engine" {
  class NUpCalculator {
    +new(u8): Result
    +with_config(NUpConfig)
    +calculate(input, PageSize): NUpLayout
  }
  class NUpLayout {
    +pages: Vec<PageResult>
    +output_size: PageSize
    +pages_per_sheet: u8
  }
  class PageResult {
    +output_page: usize
    +input_pages: Vec<usize>
    +position: PagePosition
  }
  class BookletCalculator
  class PageTransformer
}

package "boomaga-ipc" {
  class Message {
    +message_id: u64
    +message_type: MessageType
    +source: MessageSource
    +destination: MessageDestination
    +payload: MessagePayload
    +timestamp: i64
  }
  enum MessagePayload { PrintJobRequest; PrintJobStatus; DocumentReady; PageRendered; PrinterInfo; Custom }
  class NotificationServer {
    -socket_path: PathBuf
    +bind(path): (Self, NotificationSender)
    +run(): Result
  }
  class UnixSocketTransport {
    -socket_path: PathBuf
    +receive_message(): Result<Message>
  }
}

package "boomaga-preview (Xilem 0.4)" {
  class AppData {
    +document_path: Option<PathBuf>
    +document: Option<Document>
    +current_page: usize
    +rendered_pages: Vec<Option<CanvasImage>>
    +load_state: LoadState
    +zoom: f64
    +fill_order: FillOrder
    +print_options: PrintOptions
    +page_range_input: String
    +printers: Vec<String>
    +print_state: PrintState
    +job_statuses: HashMap<String, JobStatus>
    +ipc_state: IpcState
    +apply_shortcut(PreviewShortcut)
    +handle_renderer_event(RendererEvent)
    +handle_ipc_event(IpcEvent)
    +handle_print_event(PrintEvent)
  }
  enum PreviewShortcut { NextPage; PreviousPage; ZoomIn; ZoomOut; ResetZoom }
  enum LoadState { Idle; Loading; Ready; Error }
  enum FillOrder { Horizontal; Vertical }
  enum IpcState { Connecting; Connected; Disconnected }
  enum PrintState { Discovering; Ready; Submitting; Error }

  class PdfCanvasWidget {
    -images: Vec<CanvasImage>
    -zoom: f64
    +on_pointer_event(...)
    +on_text_event(...)
    +access(...)
  }
  class CanvasImage
  class DocumentRenderer {
    +load_document(Path): Result<Document>
    +render_page(usize): Result<CanvasImage>
  }
  enum RendererCommand { LoadDocument; RenderPage }
  enum RendererEvent { DocumentLoaded; PageRendered; Failed }
  enum IpcCommand { Connect }
  enum IpcEvent { Message; Disconnected }
  class PrinterCapabilities { +supports_duplex: bool; +supports_collate: bool }
  enum PrintCommand { Discover; DiscoverCapabilities; Submit }
  enum PrintEvent { Printers; Capabilities; CapabilitiesFailed; Submitted; Failed }
  class SubmissionPlan {
    +jobs: Vec<SubmissionJob>
    +new(page_count, options): Result<Self>
  }
  class SubmissionJob { +copies: u32; +pages: PageRange }
}

package "boomaga-config" {
  class ConfigManager
  class Settings
}

' ---- Relationships realized in code ----
Document "1" *-- "*" Page
Page --> PageContents
PrintJobRequest --> JobId
PrintJobRequest --> PrintOptions
PrintJobRequest --> FileType
PrintOptions --> PageRange
PrintOptions --> DuplexMode
PrintOptions --> Orientation
PrintOptions --> PagesPerSheet
PrintOptions --> MarginMode
JobMetadata --> JobId
JobMetadata --> JobStatus
JobMetadata --> JobPriority
IppServer o--> JobProcessor
JobProcessor o--> JobQueue
JobProcessor --> NotificationServer : sender
JobQueue --> PrintJobRequest
IppRequest --> IppOperation
IppResponse --> IppStatusCode
NotificationServer --> Message
UnixSocketTransport --> Message
NUpCalculator --> NUpLayout
NUpLayout "1" *-- "*" PageResult
AppData --> Document
AppData --> PrintOptions
AppData --> JobStatus
AppData --> NUpCalculator
AppData --> PreviewShortcut
AppData --> RendererCommand
RendererEvent --> AppData
AppData --> IpcCommand
IpcEvent --> AppData
UnixSocketTransport --> IpcEvent
AppData --> PrintCommand
PrintEvent --> AppData
AppData --> PdfCanvasWidget
PdfCanvasWidget --> CanvasImage
PdfCanvasWidget --> PreviewShortcut : focused key event
DocumentRenderer --> RendererEvent
PrintCommand --> PrintOptions
PrintCommand --> SubmissionPlan
SubmissionPlan "1" *-- "*" SubmissionJob
SubmissionJob --> PageRange
Message --> MessagePayload
ConfigManager --> Settings

' ---- Decided but not yet wired ----
IppServer .[#gray,dashed].> AppData : <<planned>> captured-document handoff
JobProcessor .[#gray,dashed].> NUpCalculator : <<planned>> output imposition
@enduml
