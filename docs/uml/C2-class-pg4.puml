
package "boomaga-ipc" {
  class Message {
    +message_id: u64
    +message_type: MessageType
    +source: MessageSource
    +destination: MessageDestination
    +payload: MessagePayload
    +timestamp: i64
  }
  enum MessagePayload { PrintJobRequest; PrintJobStatus; DocumentReady; PageRendered; PrinterInfo; Custom }
  class NotificationServer {
    -socket_path: PathBuf
    +bind(path): (Self, NotificationSender)
    +run(): Result
  }
  class UnixSocketTransport {
    -socket_path: PathBuf
    +receive_message(): Result<Message>
  }
}
