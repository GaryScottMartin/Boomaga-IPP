@startuml
title Boomaga-IPP — System Class Diagram (conforms to code @ e77d08c)
skinparam classAttributeIconSize 0
hide empty members

package "boomaga-core" {
  class Document {
    +id: String
    +file_path: PathBuf
    +file_type: FileType
    +title: String
    +pages: Vec<Page>
    +page_count(): usize
  }
  class Page {
    +number: usize
    +width: f64
    +height: f64
    +orientation: Orientation
    +contents: PageContents
  }
  class PrintJobRequest {
    +job_id: JobId
    +file_path: PathBuf
    +file_type: FileType
    +printer_name: Option<String>
    +options: PrintOptions
  }
  class PageRange {
    +from_pages(&[usize]): Self
    +pages(page_count): Result<Vec<usize>>
  }
  class PrintOptions {
    +copies: u32
    +collate: bool
    +duplex: DuplexMode
    +orientation: Orientation
    +page_range: Option<PageRange>
    +pages_per_sheet: PagesPerSheet
    +scale: f64
    +margins: MarginMode
    +validate(): Result
  }
