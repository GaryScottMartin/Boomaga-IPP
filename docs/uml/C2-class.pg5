    +handle_print_event(PrintEvent)
  }
  enum PreviewShortcut {
    NextPage
    PreviousPage
    ZoomIn
    ZoomOut
    ResetZoom
  }
  enum LoadState {
    Idle
    Loading
    Ready
    Error
  }
  enum FillOrder {
