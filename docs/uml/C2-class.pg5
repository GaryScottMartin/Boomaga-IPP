    Vertical
  }
  enum IpcState {
    Connecting
    Connected
    Disconnected
  }
  enum PrintState {
    Discovering
    Ready
    Submitting
    Error
  }

  class PdfCanvasWidget {
    -images: Vec<CanvasImage>
    -zoom: f64
    +on_pointer_event(...)
    +on_text_event(...)
    +access(...)
  }
  class CanvasImage
  class DocumentRenderer {
    +load_document(Path): Result<Document>
    +render_page(usize): Result<CanvasImage>
  }
